# ==============================================================================
# BRIGHTPATH CRM — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your Supabase credentials.
# Retrieve these from: https://supabase.com/dashboard/project/<your-project-id>/settings/api

# Public URL of your hosted Supabase instance
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public / Anonymous API Key (safe for frontend client bundling)
# NEVER put your service_role secret key here!
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
